# Copy to .env.local (local) or set in Vercel → Project → Settings → Environment Variables.
# Form emails are sent with Resend (https://resend.com). Verify amstrak.com there first.
RESEND_API_KEY=
# Sender, must be on a domain verified in Resend, e.g. "Amstrak Web <web@amstrak.com>"
EMAIL_FROM=
# Where quote and contact requests go (comma-separated). Defaults to quotes@amstrak.com.
EMAIL_TO=quotes@amstrak.com
